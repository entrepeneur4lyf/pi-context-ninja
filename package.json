{
  "name": "pi-context-ninja",
  "version": "0.3.0",
  "type": "module",
  "description": "Silent-first context freshness extension for oh-my-pi",
  "keywords": [
    "omp-package",
    "pi-package"
  ],
  "omp": {
    "extensions": [
      "./src/index.ts"
    ]
  },
  "pi": {
    "extensions": [
      "./src/index.ts"
    ]
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "check": "bun run typecheck && bun test"
  },
  "engines": {
    "bun": ">=1.3.14"
  },
  "dependencies": {
    "yaml": "^2.8.0"
  },
  "devDependencies": {
    "@oh-my-pi/pi-agent-core": "18.1.2",
    "@oh-my-pi/pi-ai": "18.1.2",
    "@oh-my-pi/pi-coding-agent": "18.1.2",
    "@types/bun": "^1.3.14",
    "typescript": "^5.9.0"
  }
}
